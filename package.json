{
  "name": "flowguard",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @flowguard/api test",
    "test:e2e": "pnpm --filter @flowguard/web exec playwright test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @flowguard/api exec prisma migrate dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
