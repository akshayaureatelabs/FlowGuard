# ── Storage (pick ONE) ──────────────────────────────────────────
# Recommended (no Docker): MongoDB local or free Atlas
USE_DATABASE="mongo"
MONGODB_URL="mongodb://127.0.0.1:27017/flowguard"
# Atlas example:
# MONGODB_URL="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/flowguard"

# Optional Postgres (needs Docker or local Postgres):
# USE_DATABASE="true"
# DATABASE_URL="postgresql://flowguard:flowguard@localhost:5432/flowguard?schema=public"

# Memory only (data lost on restart):
# USE_DATABASE="false"

AUTH_DISABLED="true"
USE_LOCAL_EXECUTION="true"
ARTIFACTS_DIR="./artifacts"
REDIS_URL=""
JWT_SECRET="change-me-in-development"
RATE_LIMIT_MAX="300"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="flowguard-artifacts"
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3001
