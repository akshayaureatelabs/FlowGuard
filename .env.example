# ── Database (set USE_DATABASE=true to persist data across restarts) ──
DATABASE_URL="postgresql://flowguard:flowguard@localhost:5432/flowguard?schema=public"
USE_DATABASE="true"

# Keep auth off while using DB so UI works without login (optional)
AUTH_DISABLED="true"

USE_LOCAL_EXECUTION="true"
ARTIFACTS_DIR="./artifacts"
REDIS_URL=""
JWT_SECRET="change-me-in-development"
RATE_LIMIT_MAX="300"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="flowguard-artifacts"
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3001
